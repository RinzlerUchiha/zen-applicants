APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Applicant documents (HireFlow 2.5) — config/filesystems.php 'applicant_documents'.
# Local development needs nothing here: files stay on this machine under
# storage/app/private/applicant/documents.
# APPLICANT_DOCUMENTS_DRIVER=local
# APPLICANT_DOCUMENTS_LOCAL_ROOT=
#
# Production: the company bucket, under zenhub/applicant/documents/.
# Use credentials issued to this application only (least privilege, limited to
# that prefix) — never zen-admin's AWS_* keys. Leave the key and secret unset to
# use the server's IAM role instead.
# APPLICANT_DOCUMENTS_DRIVER=s3
# APPLICANT_DOCUMENTS_AWS_ACCESS_KEY_ID=
# APPLICANT_DOCUMENTS_AWS_SECRET_ACCESS_KEY=
# APPLICANT_DOCUMENTS_AWS_REGION=ap-southeast-1
# APPLICANT_DOCUMENTS_AWS_BUCKET=e-classtngcacademy
# APPLICANT_DOCUMENTS_AWS_ROOT=zenhub

VITE_APP_NAME="${APP_NAME}"
